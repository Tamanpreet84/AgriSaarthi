@model AgriSaarthi.Api.Models.ViewModels.CropRecommendationViewModel
@{
    ViewData["Title"] = "Crop Advisory & Recommendation";
}

<div class="max-w-5xl mx-auto space-y-6">

    <!-- Header Banner -->
    <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center space-x-2 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-[#27ae60] mb-2">
                <i class="fa-solid fa-brain text-xs"></i>
                <span>99.2% Random Forest Machine Learning Model</span>
            </div>
            <h1 class="text-2xl font-bold text-[#1b4332] tracking-tight">Precision Crop Recommendation</h1>
            <p class="text-sm text-slate-500 mt-1">Provide your soil macronutrient analysis and local climate parameters to get the optimal crop recommendation.</p>
        </div>
        <div class="hidden sm:flex w-14 h-14 rounded-2xl bg-[#e8f3ee] text-[#27ae60] items-center justify-center text-2xl flex-shrink-0">
            <i class="fa-solid fa-seedling"></i>
        </div>
    </div>

    @if (Model.HasResult)
    {
        <!-- Result Display Card -->
        <div class="bg-gradient-to-br from-[#1b4332] via-[#2d6a4f] to-[#40916c] rounded-2xl p-6 sm:p-8 text-white shadow-xl animate-fade-in relative overflow-hidden">
            <div class="relative z-10">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-white/20">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-wider text-emerald-300">Top Recommended Crop</span>
                        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mt-1 text-white">@Model.RecommendedCrop</h2>
                        <p class="text-xs text-emerald-100 mt-1">Saved to SQL Server Database Table <code class="bg-black/30 px-1.5 py-0.5 rounded text-white font-mono">CropAdvisories</code></p>
                    </div>
                    <div class="flex items-center space-x-3 bg-white/10 px-4 py-3 rounded-2xl backdrop-blur-sm self-start sm:self-auto">
                        <div class="w-12 h-12 rounded-xl bg-white text-[#1b4332] flex items-center justify-center font-black text-lg shadow">
                            @Model.ConfidencePercent%
                        </div>
                        <div>
                            <span class="block text-xs font-bold text-white">Prediction Confidence</span>
                            <span class="text-[10px] text-emerald-200">High Suitability Index</span>
                        </div>
                    </div>
                </div>

                <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                    <div class="bg-white/10 p-4 rounded-xl backdrop-blur-sm">
                        <p class="font-bold text-emerald-200 text-sm mb-1"><i class="fa-solid fa-circle-info mr-1.5"></i> Soil & Climate Match:</p>
                        <p class="text-white leading-relaxed">@Model.SuitabilityNotes</p>
                    </div>
                    <div class="bg-white/10 p-4 rounded-xl backdrop-blur-sm">
                        <p class="font-bold text-amber-200 text-sm mb-1"><i class="fa-solid fa-flask-vial mr-1.5"></i> Recommended Fertilizer Strategy:</p>
                        <p class="text-white leading-relaxed">@Model.FertilizerAdvice</p>
                    </div>
                </div>

                <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                    <div class="bg-black/20 p-3 rounded-xl">
                        <span class="text-emerald-300 block font-bold">Optimal Sowing Season:</span>
                        <span class="text-white mt-0.5 block">@Model.SowingSeason</span>
                    </div>
                    <div class="bg-black/20 p-3 rounded-xl">
                        <span class="text-emerald-300 block font-bold">Water Requirement:</span>
                        <span class="text-white mt-0.5 block">@Model.WaterRequirement</span>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Soil & Climate Input Form -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 sm:p-8">
        <h2 class="text-base font-bold text-slate-800 pb-4 border-b border-slate-100 flex items-center space-x-2">
            <i class="fa-solid fa-sliders text-[#27ae60]"></i>
            <span>7 Agronomic Input Parameters</span>
        </h2>

        <form asp-controller="Crop" asp-action="Recommend" method="post" class="mt-6 space-y-6">
            @Html.AntiForgeryToken()

            <!-- Macronutrients N-P-K -->
            <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">1. Soil Macronutrients (NPK Ratios)</p>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    
                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                        <label asp-for="Nitrogen" class="block text-xs font-bold text-slate-700 mb-1">Nitrogen (N)</label>
                        <span class="text-[10px] text-slate-400 block mb-2">mg/kg (Range: 0 - 200)</span>
                        <input asp-for="Nitrogen" type="number" step="0.1" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-bold text-slate-800 focus:ring-2 focus:ring-[#27ae60] focus:outline-none" />
                        <span asp-validation-for="Nitrogen" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                        <label asp-for="Phosphorus" class="block text-xs font-bold text-slate-700 mb-1">Phosphorus (P)</label>
                        <span class="text-[10px] text-slate-400 block mb-2">mg/kg (Range: 0 - 200)</span>
                        <input asp-for="Phosphorus" type="number" step="0.1" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-bold text-slate-800 focus:ring-2 focus:ring-[#27ae60] focus:outline-none" />
                        <span asp-validation-for="Phosphorus" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                        <label asp-for="Potassium" class="block text-xs font-bold text-slate-700 mb-1">Potassium (K)</label>
                        <span class="text-[10px] text-slate-400 block mb-2">mg/kg (Range: 0 - 300)</span>
                        <input asp-for="Potassium" type="number" step="0.1" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-bold text-slate-800 focus:ring-2 focus:ring-[#27ae60] focus:outline-none" />
                        <span asp-validation-for="Potassium" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                </div>
            </div>

            <!-- Climate & Soil Chemistry -->
            <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">2. Climate & Soil Chemistry</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    
                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                        <label asp-for="Temperature" class="block text-xs font-bold text-slate-700 mb-1">Temperature (°C)</label>
                        <span class="text-[10px] text-slate-400 block mb-2">Ambient air temp</span>
                        <input asp-for="Temperature" type="number" step="0.1" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-bold text-slate-800 focus:ring-2 focus:ring-[#27ae60] focus:outline-none" />
                        <span asp-validation-for="Temperature" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                        <label asp-for="Humidity" class="block text-xs font-bold text-slate-700 mb-1">Humidity (%)</label>
                        <span class="text-[10px] text-slate-400 block mb-2">Relative humidity</span>
                        <input asp-for="Humidity" type="number" step="0.1" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-bold text-slate-800 focus:ring-2 focus:ring-[#27ae60] focus:outline-none" />
                        <span asp-validation-for="Humidity" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                        <label asp-for="Ph" class="block text-xs font-bold text-slate-700 mb-1">Soil pH (0-14)</label>
                        <span class="text-[10px] text-slate-400 block mb-2">Acidity / Alkalinity</span>
                        <input asp-for="Ph" type="number" step="0.1" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-bold text-slate-800 focus:ring-2 focus:ring-[#27ae60] focus:outline-none" />
                        <span asp-validation-for="Ph" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                        <label asp-for="Rainfall" class="block text-xs font-bold text-slate-700 mb-1">Rainfall (mm)</label>
                        <span class="text-[10px] text-slate-400 block mb-2">Annual precipitation</span>
                        <input asp-for="Rainfall" type="number" step="0.1" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm font-bold text-slate-800 focus:ring-2 focus:ring-[#27ae60] focus:outline-none" />
                        <span asp-validation-for="Rainfall" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                </div>
            </div>

            <!-- Action Button -->
            <div class="pt-4 flex items-center justify-end space-x-3">
                <a asp-controller="Home" asp-action="Dashboard" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-semibold text-sm hover:bg-slate-50 transition">Cancel</a>
                <button type="submit" class="px-6 py-2.5 bg-[#27ae60] hover:bg-[#219653] text-white font-bold rounded-xl text-sm shadow-md hover:shadow-lg transition flex items-center space-x-2">
                    <i class="fa-solid fa-wand-magic-sparkles text-xs"></i>
                    <span>Run Advisory Prediction</span>
                </button>
            </div>
        </form>
    </div>

</div>
