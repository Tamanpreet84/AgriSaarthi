@model AgriSaarthi.Api.Models.ViewModels.DiseaseDetectionViewModel
@{
    ViewData["Title"] = "Plant Pathology & Disease Scanner";
}

<div class="max-w-5xl mx-auto space-y-6">

    <!-- Header -->
    <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center space-x-2 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-[#27ae60] mb-2">
                <i class="fa-solid fa-microscope text-xs"></i>
                <span>Computer Vision & Agronomic Pathology</span>
            </div>
            <h1 class="text-2xl font-bold text-[#1b4332] tracking-tight">Plant Leaf Pathology & Health Scanner</h1>
            <p class="text-sm text-slate-500 mt-1">Upload leaf photos or review identified plant pathologies with automated organic & chemical treatments.</p>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-[#e8f3ee] text-[#145a32] flex items-center justify-center text-xl flex-shrink-0">
            <i class="fa-solid fa-leaf"></i>
        </div>
    </div>

    <!-- Upload / Scan Area -->
    <div class="bg-white rounded-2xl border-2 border-dashed border-emerald-300 p-8 text-center hover:bg-emerald-50/30 transition cursor-pointer">
        <div class="w-16 h-16 rounded-full bg-emerald-50 text-[#27ae60] flex items-center justify-center text-2xl mx-auto mb-3">
            <i class="fa-solid fa-cloud-arrow-up"></i>
        </div>
        <h3 class="font-bold text-slate-800 text-base">Upload Leaf Photo for Machine Learning Diagnosis</h3>
        <p class="text-xs text-slate-500 max-w-md mx-auto mt-1">Drag and drop smartphone leaf photo here, or browse files (Supports JPG, PNG, WEBP). Tested on 38+ plant leaf pathologies.</p>
        <button class="mt-4 px-4 py-2 bg-[#27ae60] text-white rounded-xl text-xs font-bold hover:bg-[#219653] shadow transition">Select Leaf Photo</button>
    </div>

    @if (Model.HasDiagnosis)
    {
        <!-- Pathology Report Card -->
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 sm:p-8 space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-100">
                <div>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200 uppercase tracking-wider">Verified Pathogen Analysis</span>
                    <h2 class="text-2xl font-black text-slate-900 mt-1">@Model.DiseaseName</h2>
                    <p class="text-xs text-slate-500 mt-1">Crop Host: <span class="font-bold text-[#1b4332]">@Model.SelectedCrop</span> • Severity: <span class="font-bold text-amber-600">@Model.Severity</span></p>
                </div>
                <div class="bg-emerald-50 border border-emerald-200 px-4 py-2.5 rounded-xl text-center">
                    <span class="text-2xl font-black text-[#27ae60]">@Model.ConfidencePercent%</span>
                    <span class="block text-[10px] font-bold text-slate-500 uppercase">Detection Match</span>
                </div>
            </div>

            <div class="text-xs">
                <h4 class="font-bold text-slate-800 mb-1.5 text-sm">Pathology Description:</h4>
                <p class="text-slate-600 leading-relaxed bg-slate-50 p-4 rounded-xl">@Model.Description</p>
            </div>

            <!-- Symptoms & Treatments -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
                <div class="bg-red-50/50 border border-red-100 p-5 rounded-2xl">
                    <h4 class="font-bold text-red-900 mb-3 flex items-center space-x-2 text-sm">
                        <i class="fa-solid fa-triangle-exclamation text-red-600"></i>
                        <span>Diagnostic Field Symptoms</span>
                    </h4>
                    <ul class="space-y-2 text-slate-700">
                        @foreach (var s in Model.Symptoms)
                        {
                            <li class="flex items-start space-x-2">
                                <i class="fa-solid fa-circle-dot text-red-500 text-[10px] mt-1 flex-shrink-0"></i>
                                <span>@s</span>
                            </li>
                        }
                    </ul>
                </div>

                <div class="bg-emerald-50/50 border border-emerald-100 p-5 rounded-2xl">
                    <h4 class="font-bold text-emerald-900 mb-3 flex items-center space-x-2 text-sm">
                        <i class="fa-solid fa-prescription-bottle-medical text-[#27ae60]"></i>
                        <span>Prescribed Treatments & Remediation</span>
                    </h4>
                    <ul class="space-y-2 text-slate-700">
                        @foreach (var t in Model.RecommendedTreatments)
                        {
                            <li class="flex items-start space-x-2">
                                <i class="fa-solid fa-check text-[#27ae60] text-xs mt-1 flex-shrink-0"></i>
                                <span>@t</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }

</div>
