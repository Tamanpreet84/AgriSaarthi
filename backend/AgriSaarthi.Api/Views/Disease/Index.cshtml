@model AgriSaarthi.Api.Models.ViewModels.DiseaseDetectionViewModel
@{
    ViewData["Title"] = "Plant Pathology & Disease Scanner";
}

<div class="max-w-5xl mx-auto space-y-6">

    <!-- Header -->
    <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center space-x-2 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-[#27ae60] mb-2">
                <i class="fa-solid fa-microscope text-xs"></i>
                <span>Computer Vision & Agronomic Pathology Sentry</span>
            </div>
            <h1 class="text-2xl font-bold text-[#1b4332] tracking-tight">Plant Leaf Pathology & Health Scanner</h1>
            <p class="text-sm text-slate-500 mt-1">Upload leaf photos for instant disease identification, symptoms checklist, and certified chemical/organic treatments.</p>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-[#e8f3ee] text-[#145a32] flex items-center justify-center text-xl flex-shrink-0">
            <i class="fa-solid fa-leaf"></i>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-xl flex items-center text-red-700 text-sm">
            <i class="fa-solid fa-triangle-exclamation mr-2.5 text-base"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <!-- Interactive Leaf Upload Form -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 sm:p-8">
        <h2 class="text-base font-bold text-slate-800 pb-4 border-b border-slate-100 flex items-center space-x-2">
            <i class="fa-solid fa-camera text-[#27ae60]"></i>
            <span>Upload or Capture Crop Leaf Image</span>
        </h2>

        <form asp-controller="Disease" asp-action="Index" method="post" enctype="multipart/form-data" class="mt-6 space-y-6">
            @Html.AntiForgeryToken()

            <!-- Crop Selection Dropdown -->
            <div class="max-w-md">
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Select Target Crop Category</label>
                <div class="relative">
                    <select name="selectedCrop" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 focus:ring-2 focus:ring-[#27ae60] focus:outline-none">
                        <option value="Wheat" selected="@(Model.SelectedCrop == "Wheat")">🌾 Wheat (Kanak)</option>
                        <option value="Rice" selected="@(Model.SelectedCrop == "Rice")">🌱 Rice (Paddy / Basmati)</option>
                        <option value="Tomato" selected="@(Model.SelectedCrop == "Tomato")">🍅 Tomato</option>
                        <option value="Potato" selected="@(Model.SelectedCrop == "Potato")">🥔 Potato (Aloo)</option>
                        <option value="Cotton" selected="@(Model.SelectedCrop == "Cotton")">🌿 Cotton (Kapas)</option>
                    </select>
                </div>
            </div>

            <!-- Drag & Drop / File Input Box -->
            <div>
                <input type="file" id="leafFileInput" name="leafImage" accept="image/*" class="hidden" onchange="previewSelectedImage(this)" />

                <div id="dropZone" onclick="document.getElementById('leafFileInput').click()" 
                     class="border-2 border-dashed border-emerald-300 rounded-2xl p-8 text-center hover:bg-emerald-50/40 hover:border-[#27ae60] transition cursor-pointer bg-slate-50/50">
                    
                    <div id="uploadPrompt" class="space-y-3">
                        <div class="w-16 h-16 rounded-2xl bg-[#e8f3ee] text-[#27ae60] flex items-center justify-center text-3xl mx-auto shadow-sm">
                            <i class="fa-solid fa-cloud-arrow-up"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-slate-800 text-base">Click to Select Leaf Photo or Drag & Drop Here</h3>
                            <p class="text-xs text-slate-500 mt-1">Supports high-res smartphone photos (JPG, PNG, WEBP, up to 15MB)</p>
                        </div>
                        <button type="button" class="px-5 py-2 bg-[#27ae60] hover:bg-[#219653] text-white rounded-xl text-xs font-bold shadow transition inline-flex items-center space-x-2 pointer-events-none">
                            <i class="fa-solid fa-folder-open text-xs"></i>
                            <span>Browse Device Files</span>
                        </button>
                    </div>

                    <!-- Client-side Image Preview Box (Hidden until selected) -->
                    <div id="previewContainer" class="hidden space-y-3">
                        <div class="relative inline-block">
                            <img id="imagePreview" src="#" alt="Selected Leaf" class="max-h-64 rounded-xl shadow-md border-2 border-emerald-500 mx-auto object-cover" />
                            <span id="selectedFileName" class="block text-xs font-bold text-slate-700 mt-2"></span>
                        </div>
                        <p class="text-xs text-emerald-600 font-semibold"><i class="fa-solid fa-circle-check mr-1"></i> Leaf image ready for pathology scan. Click below to analyze!</p>
                    </div>

                </div>
            </div>

            <!-- Submit Button & Quick Preset Pills -->
            <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-4">
                
                <!-- Quick Test Presets (Instant Demonstration) -->
                <div>
                    <span class="text-xs font-bold text-slate-500 block mb-1.5">Or Run Instant Sample Test:</span>
                    <div class="flex flex-wrap gap-2">
                        <button type="submit" name="samplePreset" value="Wheat" class="px-3 py-1.5 bg-slate-100 hover:bg-amber-100 hover:text-amber-800 text-slate-700 text-xs font-semibold rounded-lg transition border border-slate-200">
                            🌾 Wheat Yellow Rust
                        </button>
                        <button type="submit" name="samplePreset" value="Rice" class="px-3 py-1.5 bg-slate-100 hover:bg-emerald-100 hover:text-emerald-800 text-slate-700 text-xs font-semibold rounded-lg transition border border-slate-200">
                            🌱 Rice Blast
                        </button>
                        <button type="submit" name="samplePreset" value="Tomato" class="px-3 py-1.5 bg-slate-100 hover:bg-red-100 hover:text-red-800 text-slate-700 text-xs font-semibold rounded-lg transition border border-slate-200">
                            🍅 Tomato Blight
                        </button>
                        <button type="submit" name="samplePreset" value="Potato" class="px-3 py-1.5 bg-slate-100 hover:bg-purple-100 hover:text-purple-800 text-slate-700 text-xs font-semibold rounded-lg transition border border-slate-200">
                            🥔 Potato Blight
                        </button>
                    </div>
                </div>

                <!-- Primary Scan Button -->
                <button type="submit" class="w-full sm:w-auto px-7 py-3 bg-[#27ae60] hover:bg-[#219653] text-white font-bold rounded-xl text-sm shadow-md hover:shadow-lg transition flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-microscope text-xs"></i>
                    <span>Scan & Diagnose Leaf</span>
                </button>

            </div>

        </form>
    </div>

    @if (Model.HasDiagnosis)
    {
        <!-- Verified Pathology Report Card -->
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 sm:p-8 space-y-6 animate-fade-in">
            
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-6 border-b border-slate-100">
                <div class="flex items-start space-x-4">
                    @if (!string.IsNullOrEmpty(Model.UploadedImageBase64))
                    {
                        <img src="@Model.UploadedImageBase64" alt="Diagnosed Leaf" class="w-24 h-24 rounded-2xl object-cover shadow border border-slate-200 flex-shrink-0" />
                    }
                    else
                    {
                        <div class="w-20 h-20 rounded-2xl bg-[#e8f3ee] text-[#27ae60] flex items-center justify-center text-3xl flex-shrink-0">
                            <i class="fa-solid fa-leaf"></i>
                        </div>
                    }

                    <div>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200 uppercase tracking-wider">
                            Verified Pathogen Analysis
                        </span>
                        <h2 class="text-2xl font-black text-slate-900 mt-1">@Model.DiseaseName</h2>
                        <p class="text-xs text-slate-500 mt-1">
                            Crop: <span class="font-bold text-[#1b4332]">@Model.SelectedCrop</span> • 
                            Severity: <span class="font-bold text-amber-600">@Model.Severity</span> • 
                            @if (!string.IsNullOrEmpty(Model.ImageFileName))
                            {
                                <span>Image: <code class="font-mono text-slate-600">@Model.ImageFileName</code></span>
                            }
                        </p>
                    </div>
                </div>

                <div class="bg-emerald-50 border border-emerald-200 px-5 py-3 rounded-2xl text-center self-start md:self-auto shadow-sm">
                    <span class="text-3xl font-black text-[#27ae60]">@Model.ConfidencePercent%</span>
                    <span class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider">Detection Confidence</span>
                </div>
            </div>

            <!-- Description -->
            <div class="text-xs">
                <h4 class="font-bold text-slate-800 mb-2 text-sm flex items-center space-x-2">
                    <i class="fa-solid fa-circle-info text-blue-500"></i>
                    <span>Pathology Overview:</span>
                </h4>
                <p class="text-slate-700 leading-relaxed bg-slate-50 p-4 rounded-xl border border-slate-100">@Model.Description</p>
            </div>

            <!-- Symptoms & Treatments -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
                
                <!-- Symptoms -->
                <div class="bg-red-50/60 border border-red-100 p-5 rounded-2xl">
                    <h4 class="font-bold text-red-900 mb-3 flex items-center space-x-2 text-sm">
                        <i class="fa-solid fa-triangle-exclamation text-red-600"></i>
                        <span>Diagnostic Field Symptoms</span>
                    </h4>
                    <ul class="space-y-2 text-slate-700">
                        @foreach (var s in Model.Symptoms)
                        {
                            <li class="flex items-start space-x-2">
                                <i class="fa-solid fa-circle-dot text-red-500 text-[10px] mt-1 flex-shrink-0"></i>
                                <span>@s</span>
                            </li>
                        }
                    </ul>
                </div>

                <!-- Prescribed Treatments -->
                <div class="bg-emerald-50/60 border border-emerald-100 p-5 rounded-2xl">
                    <h4 class="font-bold text-emerald-900 mb-3 flex items-center space-x-2 text-sm">
                        <i class="fa-solid fa-prescription-bottle-medical text-[#27ae60]"></i>
                        <span>Prescribed Chemical Treatments</span>
                    </h4>
                    <ul class="space-y-2 text-slate-700">
                        @foreach (var t in Model.RecommendedTreatments)
                        {
                            <li class="flex items-start space-x-2">
                                <i class="fa-solid fa-circle-check text-[#27ae60] text-xs mt-1 flex-shrink-0"></i>
                                <span>@t</span>
                            </li>
                        }
                    </ul>
                </div>

            </div>

            <!-- Preventive Measures -->
            <div class="bg-amber-50/50 border border-amber-100 p-5 rounded-2xl text-xs">
                <h4 class="font-bold text-amber-900 mb-2.5 flex items-center space-x-2 text-sm">
                    <i class="fa-solid fa-shield-halved text-amber-600"></i>
                    <span>Organic & Cultural Preventive Measures</span>
                </h4>
                <ul class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-slate-700 mt-2">
                    @foreach (var p in Model.PreventiveMeasures)
                    {
                        <li class="bg-white p-3 rounded-xl border border-amber-100/60 shadow-sm">
                            <i class="fa-solid fa-seedling text-amber-600 mr-1.5"></i>
                            <span>@p</span>
                        </li>
                    }
                </ul>
            </div>

            <div class="text-right pt-2">
                <a asp-controller="Disease" asp-action="Index" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl text-xs transition inline-flex items-center space-x-2">
                    <i class="fa-solid fa-rotate-left text-xs"></i>
                    <span>Scan Another Leaf</span>
                </a>
            </div>

        </div>
    }

</div>

@section Scripts {
<script>
    function previewSelectedImage(input) {
        if (input.files && input.files[0]) {
            const file = input.files[0];
            const reader = new FileReader();

            reader.onload = function(e) {
                document.getElementById('imagePreview').src = e.target.result;
                document.getElementById('selectedFileName').textContent = file.name + ' (' + (file.size / 1024).toFixed(1) + ' KB)';
                document.getElementById('uploadPrompt').classList.add('hidden');
                document.getElementById('previewContainer').classList.remove('hidden');
            };

            reader.readAsDataURL(file);
        }
    }

    // Drag and Drop listeners
    const dropZone = document.getElementById('dropZone');
    ['dragenter', 'dragover'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            dropZone.classList.add('border-[#27ae60]', 'bg-emerald-50');
        }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            dropZone.classList.remove('border-[#27ae60]', 'bg-emerald-50');
        }, false);
    });

    dropZone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        const files = dt.files;
        if (files && files.length > 0) {
            document.getElementById('leafFileInput').files = files;
            previewSelectedImage(document.getElementById('leafFileInput'));
        }
    });
</script>
}
