@model AgriSaarthi.Api.Models.ViewModels.MarketPricesViewModel
@{
    ViewData["Title"] = "Live Mandi Market Rates";
}

<div class="max-w-5xl mx-auto space-y-6">

    <!-- Header Banner -->
    <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center space-x-2 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 mb-2">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse mr-1"></span>
                <span>Agmarknet & APMC Live Feeds Active</span>
            </div>
            <h1 class="text-2xl font-bold text-[#1b4332] tracking-tight">Agricultural Mandi Market Rates</h1>
            <p class="text-sm text-slate-500 mt-1">Live benchmark auction rates from agricultural mandis across Punjab, Haryana, and neighboring farming zones.</p>
        </div>
        <div class="flex items-center space-x-3">
            <form asp-controller="Market" asp-action="RefreshPrices" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold shadow transition flex items-center space-x-1.5">
                    <i class="fa-solid fa-arrows-rotate text-xs"></i>
                    <span>Refresh Live Rates</span>
                </button>
            </form>
            <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl flex-shrink-0">
                <i class="fa-solid fa-indian-rupee-sign"></i>
            </div>
        </div>
    </div>

    <!-- 3 Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm">
            <span class="text-slate-400 block font-semibold text-[11px] uppercase">Active Reporting Mandis</span>
            <span class="text-xl font-black text-slate-900 mt-1 block">@Model.Prices.Select(p => p.Market).Distinct().Count() Mandis</span>
            <span class="text-[10px] text-emerald-600 font-semibold mt-1 block"><i class="fa-solid fa-circle-check"></i> Punjab & Haryana APMC Feeds</span>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm">
            <span class="text-slate-400 block font-semibold text-[11px] uppercase">Highest Valued Commodity</span>
            <span class="text-xl font-black text-[#1b4332] mt-1 block">
                @(Model.Prices.OrderByDescending(p => p.ModalPrice).FirstOrDefault()?.Commodity ?? "Cotton (Kapas)")
            </span>
            <span class="text-[10px] text-slate-500 font-semibold mt-1 block">
                ₹@(Model.Prices.OrderByDescending(p => p.ModalPrice).FirstOrDefault()?.ModalPrice ?? 7250) / Quintal
            </span>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm">
            <span class="text-slate-400 block font-semibold text-[11px] uppercase">Latest APMC Sync Timestamp</span>
            <span class="text-xl font-black text-slate-900 mt-1 block">Today, Live</span>
            <span class="text-[10px] text-sky-600 font-semibold mt-1 block"><i class="fa-solid fa-clock"></i> Updated with morning auction bids</span>
        </div>
    </div>

    <!-- Search and Filter Bar -->
    <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm">
        <form asp-controller="Market" asp-action="Index" method="get" class="grid grid-cols-1 sm:grid-cols-4 gap-3 text-xs">
            <div class="sm:col-span-2">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search commodity, mandi or district..." class="w-full pl-9 pr-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#27ae60] focus:outline-none" />
                </div>
            </div>
            <div>
                <select name="state" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#27ae60] focus:outline-none font-medium">
                    <option value="All">All States (National)</option>
                    <option value="Punjab" selected="@(Model.SelectedState == "Punjab")">Punjab</option>
                    <option value="Haryana" selected="@(Model.SelectedState == "Haryana")">Haryana</option>
                    <option value="Uttar Pradesh" selected="@(Model.SelectedState == "Uttar Pradesh")">Uttar Pradesh</option>
                    <option value="Rajasthan" selected="@(Model.SelectedState == "Rajasthan")">Rajasthan</option>
                </select>
            </div>
            <div>
                <button type="submit" class="w-full py-2.5 bg-[#27ae60] hover:bg-[#219653] text-white font-bold rounded-xl transition shadow flex items-center justify-center space-x-1.5">
                    <i class="fa-solid fa-filter text-xs"></i>
                    <span>Apply Filter</span>
                </button>
            </div>
        </form>
    </div>

    <!-- Market Rates Table -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 border-b border-slate-100 text-slate-500 uppercase font-bold text-[11px] tracking-wider">
                    <tr>
                        <th class="py-3.5 px-5">Commodity Name</th>
                        <th class="py-3.5 px-4">APMC Mandi</th>
                        <th class="py-3.5 px-4">State</th>
                        <th class="py-3.5 px-4 text-right">Min Rate</th>
                        <th class="py-3.5 px-4 text-right">Max Rate</th>
                        <th class="py-3.5 px-5 text-right font-black text-slate-800">Modal Price (₹/Qtl)</th>
                        <th class="py-3.5 px-4 text-center">Trend</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model.Prices.Any())
                    {
                        @foreach (var p in Model.Prices)
                        {
                            <tr class="hover:bg-slate-50/80 transition">
                                <td class="py-4 px-5">
                                    <span class="font-bold text-slate-900 block text-sm">@p.Commodity</span>
                                    <span class="text-[10px] text-slate-400">Unit: 1 Quintal (100 kg)</span>
                                </td>
                                <td class="py-4 px-4 font-semibold text-slate-700">@p.Market</td>
                                <td class="py-4 px-4">
                                    <span class="px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 font-bold text-[10px]">@p.State</span>
                                </td>
                                <td class="py-4 px-4 text-right text-slate-600">₹@p.MinPrice</td>
                                <td class="py-4 px-4 text-right text-slate-600">₹@p.MaxPrice</td>
                                <td class="py-4 px-5 text-right font-black text-base text-[#1b4332]">₹@p.ModalPrice</td>
                                <td class="py-4 px-4 text-center">
                                    @if (p.Trend == "up")
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <i class="fa-solid fa-arrow-up mr-1 text-[9px]"></i> Rising
                                        </span>
                                    }
                                    else if (p.Trend == "down")
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-50 text-red-700 border border-red-200">
                                            <i class="fa-solid fa-arrow-down mr-1 text-[9px]"></i> Falling
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600">
                                            • Stable
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-8 text-center text-slate-400">
                                <i class="fa-solid fa-store-slash text-3xl mb-2 text-slate-300"></i>
                                <p class="text-xs">No mandi prices found matching your filter. Try clearing your search.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
