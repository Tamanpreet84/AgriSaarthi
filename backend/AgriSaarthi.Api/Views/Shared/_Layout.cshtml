        // Multilingual Switcher (Default: English)
        function setLanguage(lang) {
            if (!translations[lang]) lang = 'en';

            // Save preference to localStorage
            localStorage.setItem('agrisaarthi_lang', lang);

            // Update UI text for all data-i18n elements
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations[lang] && translations[lang][key]) {
                    el.textContent = translations[lang][key];
                }
            });

            // Update placeholders for search inputs
            document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
                const key = el.getAttribute('data-i18n-placeholder');
                if (translations[lang] && translations[lang][key]) {
                    el.placeholder = translations[lang][key];
                }
            });

            // Update active button styles
            ['en', 'hi', 'pa'].forEach(l => {
                const btn = document.getElementById('btn-lang-' + l);
                if (btn) {
                    if (l === lang) {
                        btn.className = 'px-2.5 py-1 rounded-lg transition font-bold bg-white text-brand-dark shadow-sm';
                    } else {
                        btn.className = 'px-2.5 py-1 rounded-lg transition text-slate-600 hover:text-brand-dark font-medium';
                    }
                }
            });
        }

        // Dark Mode / Light Mode Engine (Default: Light Mode)
        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            const theme = isDark ? 'dark' : 'light';
            localStorage.setItem('agrisaarthi_theme', theme);
            updateThemeUI(theme);
        }

        function updateThemeUI(theme) {
            const icon = document.getElementById('theme-icon');
            const label = document.getElementById('theme-label');
            const btn = document.getElementById('btn-theme-toggle');
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
                if (icon) icon.className = 'fa-solid fa-sun text-amber-400 text-sm';
                if (label) label.textContent = 'Light';
                if (btn) btn.className = 'flex items-center space-x-1.5 px-3 py-1.5 rounded-xl border border-slate-700 bg-slate-800 text-slate-100 text-xs font-bold shadow-sm transition';
            } else {
                document.documentElement.classList.remove('dark');
                if (icon) icon.className = 'fa-solid fa-moon text-amber-500 text-sm';
                if (label) label.textContent = 'Dark';
                if (btn) btn.className = 'flex items-center space-x-1.5 px-3 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold shadow-sm transition';
            }
        }

        // Apply saved language & theme on initial page load
        document.addEventListener('DOMContentLoaded', () => {
            // Default to Light Mode
            const savedTheme = localStorage.getItem('agrisaarthi_theme') || 'light';
            updateThemeUI(savedTheme);

            // Default to English
            const savedLang = localStorage.getItem('agrisaarthi_lang') || 'en';
            setLanguage(savedLang);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
