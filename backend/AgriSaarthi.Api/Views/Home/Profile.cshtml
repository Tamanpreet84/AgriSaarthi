@model AgriSaarthi.Api.Models.FarmerProfile
@{
    ViewData["Title"] = "Farmer Profile & Farm Settings";
}

<div class="max-w-4xl mx-auto space-y-6">

    <!-- Header -->
    <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-[#1b4332] tracking-tight">Farmer Profile & Farm Details</h1>
            <p class="text-sm text-slate-500 mt-1">Manage your farm specifications, soil characteristics, and geographical coordinates in Microsoft SQL Server.</p>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-[#e8f3ee] text-[#1b4332] flex items-center justify-center text-xl">
            <i class="fa-solid fa-user-gear"></i>
        </div>
    </div>

    <!-- Account Details Card -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 sm:p-8">
        <h3 class="font-bold text-slate-800 text-sm pb-4 border-b border-slate-100 flex items-center space-x-2">
            <i class="fa-regular fa-id-card text-[#27ae60]"></i>
            <span>Account Credentials</span>
        </h3>

        <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
            <div class="bg-slate-50 p-3.5 rounded-xl">
                <span class="text-slate-400 block text-[10px] font-bold uppercase">Registered Name:</span>
                <span class="font-bold text-slate-800 text-sm">@ViewBag.FarmerName</span>
            </div>
            <div class="bg-slate-50 p-3.5 rounded-xl">
                <span class="text-slate-400 block text-[10px] font-bold uppercase">Email Address:</span>
                <span class="font-bold text-slate-800 text-sm">@ViewBag.FarmerEmail</span>
            </div>
            <div class="bg-slate-50 p-3.5 rounded-xl">
                <span class="text-slate-400 block text-[10px] font-bold uppercase">Phone Number:</span>
                <span class="font-bold text-slate-800 text-sm">@ViewBag.FarmerPhone</span>
            </div>
        </div>
    </div>

    <!-- Farm Profile Form -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 sm:p-8">
        <h3 class="font-bold text-slate-800 text-sm pb-4 border-b border-slate-100 flex items-center space-x-2">
            <i class="fa-solid fa-wheat-awn text-[#27ae60]"></i>
            <span>Agricultural Specifications</span>
        </h3>

        <form asp-controller="Home" asp-action="Profile" method="post" class="mt-6 space-y-5">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="FarmSize" class="block text-xs font-bold text-slate-700 uppercase mb-1">Farm Area (Acres)</label>
                    <input asp-for="FarmSize" type="number" step="0.1" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold focus:ring-2 focus:ring-[#27ae60] focus:outline-none" />
                </div>

                <div>
                    <label asp-for="PrimaryCrop" class="block text-xs font-bold text-slate-700 uppercase mb-1">Primary Crop Cultivated</label>
                    <input asp-for="PrimaryCrop" type="text" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold focus:ring-2 focus:ring-[#27ae60] focus:outline-none" placeholder="e.g. Wheat & Basmati Rice" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="SoilType" class="block text-xs font-bold text-slate-700 uppercase mb-1">Soil Classification</label>
                    <select asp-for="SoilType" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold focus:ring-2 focus:ring-[#27ae60] focus:outline-none">
                        <option value="Alluvial Loam">Alluvial Loam</option>
                        <option value="Clay Loam">Clay Loam</option>
                        <option value="Sandy Loam">Sandy Loam</option>
                        <option value="Black Cotton Soil">Black Cotton Soil</option>
                        <option value="Red Laterite Soil">Red Laterite Soil</option>
                    </select>
                </div>

                <div>
                    <label asp-for="IrrigationType" class="block text-xs font-bold text-slate-700 uppercase mb-1">Irrigation System</label>
                    <select asp-for="IrrigationType" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold focus:ring-2 focus:ring-[#27ae60] focus:outline-none">
                        <option value="Canal / Tube Well">Canal / Tube Well</option>
                        <option value="Drip Irrigation">Drip Irrigation</option>
                        <option value="Sprinkler Irrigation">Sprinkler Irrigation</option>
                        <option value="Submersible Borewell">Submersible Borewell</option>
                        <option value="Rainfed (Barani)">Rainfed (Barani)</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label asp-for="Location" class="block text-xs font-bold text-slate-700 uppercase mb-1">Village / Tehsil</label>
                    <input asp-for="Location" type="text" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold focus:ring-2 focus:ring-[#27ae60] focus:outline-none" placeholder="e.g. Phagwara" />
                </div>

                <div>
                    <label asp-for="District" class="block text-xs font-bold text-slate-700 uppercase mb-1">District</label>
                    <input asp-for="District" type="text" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold focus:ring-2 focus:ring-[#27ae60] focus:outline-none" placeholder="e.g. Kapurthala" />
                </div>

                <div>
                    <label asp-for="State" class="block text-xs font-bold text-slate-700 uppercase mb-1">State</label>
                    <input asp-for="State" type="text" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold focus:ring-2 focus:ring-[#27ae60] focus:outline-none" placeholder="e.g. Punjab" />
                </div>
            </div>

            <div class="pt-4 flex justify-end">
                <button type="submit" class="px-6 py-2.5 bg-[#27ae60] hover:bg-[#219653] text-white font-bold rounded-xl text-sm shadow transition flex items-center space-x-2">
                    <i class="fa-solid fa-floppy-disk text-xs"></i>
                    <span>Save to SQL Server</span>
                </button>
            </div>
        </form>
    </div>

</div>
