@model AgriSaarthi.Api.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Farmer Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - AgriSaarthi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gradient-to-br from-[#f3f7f5] via-[#e8f3ee] to-[#d8ece1] min-h-screen flex items-center justify-center p-4">

    <div class="max-w-md w-full bg-white rounded-2xl shadow-xl border border-slate-100 p-8">
        
        <!-- Brand Header -->
        <div class="text-center mb-8">
            <div class="inline-flex w-16 h-16 rounded-2xl bg-[#e8f3ee] items-center justify-center text-[#27ae60] shadow-sm mb-3">
                <i class="fa-solid fa-leaf text-3xl"></i>
            </div>
            <h1 class="text-2xl font-bold text-[#1b4332] tracking-tight">Welcome to AgriSaarthi</h1>
            <p class="text-xs uppercase font-bold text-[#d97706] tracking-wider mt-1">Know More • Grow More</p>
            <p class="text-sm text-slate-500 mt-2">Sign in to access your farmer advisory dashboard</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mb-5 bg-red-50 border-l-4 border-red-500 p-3.5 rounded-r-lg flex items-center text-red-700 text-sm">
                <i class="fa-solid fa-circle-exclamation mr-2 text-base"></i>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div>
                <label asp-for="Email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Email Address</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                        <i class="fa-regular fa-envelope"></i>
                    </span>
                    <input asp-for="Email" class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#27ae60] focus:bg-white transition" placeholder="farmer@gmail.com" />
                </div>
                <span asp-validation-for="Email" class="text-xs text-red-600 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Password</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                        <i class="fa-solid fa-lock"></i>
                    </span>
                    <input asp-for="Password" type="password" class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-[#27ae60] focus:bg-white transition" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-xs text-red-600 mt-1 block"></span>
            </div>

            <div class="flex items-center justify-between text-xs pt-1">
                <label class="flex items-center space-x-2 text-slate-600 cursor-pointer">
                    <input asp-for="RememberMe" type="checkbox" class="rounded text-[#27ae60] focus:ring-[#27ae60]" />
                    <span>Remember this device</span>
                </label>
                <a href="#" class="text-[#27ae60] font-semibold hover:underline">Forgot password?</a>
            </div>

            <button type="submit" class="w-full py-3 px-4 bg-[#27ae60] hover:bg-[#219653] text-white font-semibold rounded-xl text-sm shadow-md hover:shadow-lg transition duration-200 flex items-center justify-center space-x-2">
                <span>Sign In to Dashboard</span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
            </button>
        </form>

        <div class="mt-6 pt-6 border-t border-slate-100 text-center text-xs text-slate-500">
            <span>Don't have an account yet?</span>
            <a asp-controller="Account" asp-action="Register" class="text-[#27ae60] font-bold hover:underline ml-1">Register as a New Farmer</a>
        </div>

        <div class="mt-6 text-center text-[11px] text-slate-400">
            <span>Powered by ASP.NET Core & Microsoft SQL Server</span>
        </div>

    </div>

</body>
</html>
