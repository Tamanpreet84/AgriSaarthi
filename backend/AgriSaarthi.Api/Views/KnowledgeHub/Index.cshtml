@model AgriSaarthi.Api.Models.ViewModels.KnowledgeHubViewModel
@{
    ViewData["Title"] = "Agronomic Knowledge Hub";
}

<div class="max-w-5xl mx-auto space-y-6">

    <!-- Header -->
    <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="inline-flex items-center space-x-2 px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 mb-2">
                <i class="fa-solid fa-book-open text-xs"></i>
                <span>Offline Agricultural Encyclopedia</span>
            </div>
            <h1 class="text-2xl font-bold text-[#1b4332] tracking-tight">Agricultural Knowledge Hub</h1>
            <p class="text-sm text-slate-500 mt-1">Scientific crop production guides, ideal soil requirements, and official government welfare schemes.</p>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl flex-shrink-0">
            <i class="fa-solid fa-graduation-cap"></i>
        </div>
    </div>

    <!-- Crop Cultivation Guides -->
    <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
        <h3 class="font-bold text-slate-800 text-sm pb-4 border-b border-slate-100 flex items-center space-x-2">
            <i class="fa-solid fa-wheat-awn text-[#27ae60]"></i>
            <span>Major Crop Production Manuals</span>
        </h3>

        <div class="mt-4 space-y-4">
            @foreach (var guide in Model.CropGuides)
            {
                <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-slate-200">
                        <h4 class="font-bold text-slate-900 text-base">@guide.CropName</h4>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-[#1b4332] self-start sm:self-auto">@guide.Season</span>
                    </div>

                    <p class="text-xs text-slate-600 mt-3 leading-relaxed">@guide.Description</p>

                    <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
                        <div class="bg-white p-2.5 rounded-xl border border-slate-100">
                            <span class="text-slate-400 block text-[10px] uppercase font-bold">Ideal Soil:</span>
                            <span class="font-bold text-slate-700">@guide.IdealSoil</span>
                        </div>
                        <div class="bg-white p-2.5 rounded-xl border border-slate-100">
                            <span class="text-slate-400 block text-[10px] uppercase font-bold">Water Requirement:</span>
                            <span class="font-bold text-slate-700">@guide.WaterNeed</span>
                        </div>
                        <div class="bg-white p-2.5 rounded-xl border border-slate-100">
                            <span class="text-slate-400 block text-[10px] uppercase font-bold">Expected Harvest Yield:</span>
                            <span class="font-bold text-[#1b4332]">@guide.ExpectedYield</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Government Schemes -->
    <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
        <h3 class="font-bold text-slate-800 text-sm pb-4 border-b border-slate-100 flex items-center space-x-2">
            <i class="fa-solid fa-landmark text-blue-600"></i>
            <span>Government Farmer Support Schemes</span>
        </h3>

        <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-4">
            @foreach (var scheme in Model.GovernmentSchemes)
            {
                <div class="p-5 rounded-2xl border border-slate-200 bg-gradient-to-b from-white to-slate-50 flex flex-col justify-between">
                    <div>
                        <h4 class="font-bold text-slate-900 text-sm leading-tight">@scheme.Name</h4>
                        <p class="text-xs text-slate-600 mt-2 leading-relaxed">@scheme.Benefit</p>
                        <p class="text-[11px] text-slate-400 mt-2"><span class="font-bold text-slate-600">Eligibility:</span> @scheme.Eligibility</p>
                    </div>
                    <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                        <span class="text-blue-600 font-bold text-[11px]">@scheme.OfficialPortal</span>
                        <i class="fa-solid fa-arrow-up-right-from-square text-slate-400 text-xs"></i>
                    </div>
                </div>
            }
        </div>
    </div>

</div>
